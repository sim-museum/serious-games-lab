+            active |= w.term[side][t] != 100;
+        }
+        for (int pt = 0; pt < PIECE_TYPE_NB; ++pt)
+            w.material[side][pt] = 100;
+        for (int pt = PAWN; pt <= QUEEN; ++pt)
+        {
+            w.material[side][pt] = int(Options[std::string("CM ") + pieces[pt] + (side ? " Opp" : " Own")]);
+            active |= w.material[side][pt] != 100;
+        }
+    }
+    w.contempt = int(Options["CM Contempt"]);
+    w.attack = int(Options["CM Attack"]);
+    w.active = active || w.attack != 0;
+    static Color lastRoot = COLOR_NB;
+    if ((w.active || W.active) && lastRoot != COLOR_NB && lastRoot != root)
+        TT.clear();               // cached evaluations depend on which side is "own"
+    lastRoot = root;
+    W = w;
+    Root = root;
+  }
+}
