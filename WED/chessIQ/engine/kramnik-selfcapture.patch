diff --git a/src/cmpersonality.h b/src/cmpersonality.h
new file mode 100644
index 0000000..6d8a017
--- /dev/null
+++ b/src/cmpersonality.h
@@ -0,0 +1,41 @@
+/*
+  Chessmaster-style personality weights for Fairy-Stockfish (chessIQ sprint CM-2, 2026-10-06).
+
+  Every weight is relative to the side the engine plays at the root ("own") or the other side ("opp"), as in a
+  Chessmaster personality. All defaults are neutral: 100 % weights, 0 contempt, 0 attack -- the engine is then
+  exactly unchanged. Loaded from the UCI options at the start of each search (MainThread::search).
+*/
+
+#ifndef CMPERSONALITY_H_INCLUDED
+#define CMPERSONALITY_H_INCLUDED
+
+#include "types.h"
+
+namespace Stockfish::CM {
+
+enum Term { CENTRE, MOBILITY, KING_SAFETY, PASSED, PAWN_WEAK, TERM_NB };
+
+struct Weights {
+  int term[2][TERM_NB];          // [own=0 / opp=1][term], percent
+  int material[2][PIECE_TYPE_NB]; // [own / opp][piece type], percent of the standard value
+  int contempt = 0;              // centipawns: a draw is worth -contempt to the engine
+  int attack = 0;                // -100..100: >0 shifts weight from own king safety to the attack on the opponent's king
+  bool active = false;           // any weight away from neutral
+};
+
+inline Weights W;
+inline Color   Root = WHITE;
+
+inline int own_or_opp(Color c) { return c == Root ? 0 : 1; }
+
+inline int term(Color c, Term t) {
+  int w = W.term[own_or_opp(c)][t];
+  if (t == KING_SAFETY && W.attack)
+      // attack > 0: care more about the opponent's king danger (attack), less about our own (defence)
+      w = w * (c == Root ? 100 - W.attack : 100 + W.attack) / 100;
+  return std::max(w, 0);
+}
+
+} // namespace Stockfish::CM
+
+#endif // #ifndef CMPERSONALITY_H_INCLUDED
