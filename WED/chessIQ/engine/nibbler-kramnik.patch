+// chessIQ EPIC NN test hook (2026-10-06): NIBBLER_BEHAVIOUR=self_play|analysis_free starts that behaviour a few
+// seconds after launch, so a scripted session needs no keypress (synthetic input does not reach windows here).
+if (typeof process !== "undefined" && process.env && process.env.NIBBLER_BEHAVIOUR) {
+	setTimeout(() => hub.set_behaviour(process.env.NIBBLER_BEHAVIOUR), 6000);
+}
+// NIBBLER_DUMP=<file>: after NIBBLER_DUMP_AFTER seconds (default 60) write what the window shows -- the move list,
+// the engine-lines panel, the status line and the FEN -- then quit. Test evidence without a screenshot.
+if (typeof process !== "undefined" && process.env && process.env.NIBBLER_DUMP) {
+	setTimeout(() => {
+		const text = id => (document.getElementById(id) || {}).innerText || "";
+		require("fs").writeFileSync(process.env.NIBBLER_DUMP, JSON.stringify({
+			movelist: text("movelist"), infobox: text("infobox"), statusbox: text("statusbox"),
+			fen: hub.tree.node.board.fen(),
+		}, null, 1));
+		require("electron").ipcRenderer.send("terminate");
+	}, 1000 * Number(process.env.NIBBLER_DUMP_AFTER || 60));
+}
