 namespace lczero {
 
+// Kramnik chess (chessIQ EPIC NN, 2026-10-06): no castling, and a piece may capture its own pieces (never its own
+// king). Compiled in with -DLC0_KRAMNIK; a normal build is standard chess.
+#ifdef LC0_KRAMNIK
+inline constexpr bool kKramnik = true;
+#else
+inline constexpr bool kKramnik = false;
+#endif
+
