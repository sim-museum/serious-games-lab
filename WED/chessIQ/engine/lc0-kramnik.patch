diff --git a/src/tools/kramnik_convert.cc b/src/tools/kramnik_convert.cc
new file mode 100644
index 0000000..2ed2e79
--- /dev/null
+++ b/src/tools/kramnik_convert.cc
@@ -0,0 +1,133 @@
+/*
+  chessIQ EPIC NN (2026-10-06): convert Kramnik Fairy-Stockfish self-play games into lc0 V6 training chunks,
+  using lc0's own board (built with -DLC0_KRAMNIK), encoder and policy index -- so the inputs and policy targets
+  are exactly what this lc0 feeds the network at play time.
+
+  lc0 kramnik-convert      (reads KRAMNIK_IN, writes one .gz chunk per game into the directory KRAMNIK_OUT)
+
+  Input, one game per block:
+    G <result: 1 white wins, 0 draw, -1 black wins>
+    M <uci move> <k> [<uci> <probability>] x k      one line per ply; k = 0 means "no policy target here"
+    E
+  Format: INPUT_CLASSICAL_112_PLANE, history fill "fen_only" (lc0's default), no castling (Kramnik chess).
+*/
+
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "chess/board.h"
+#include "chess/position.h"
+#include "neural/encoder.h"
+#include "trainingdata/trainingdata_v6.h"
+#include "trainingdata/writer.h"
+#include "utils/bititer.h"
+#include "utils/exception.h"
+
+namespace lczero {
+namespace {
+
+
+struct Ply {
+  std::string played;
+  std::vector<std::pair<std::string, float>> policy;
+};
+
+void WriteGame(const std::string& path, int result, const std::vector<Ply>& plies, long* written) {
+  PositionHistory history;
+  history.Reset(ChessBoard::kStartposBoard, 0, 0);
+  TrainingDataWriter writer(path);
+  const int n = static_cast<int>(plies.size());
+  for (int i = 0; i < n; ++i) {
+    const Ply& ply = plies[i];
+    const ChessBoard& board = history.Last().GetBoard();
+    const Move played = board.ParseMove(ply.played);
+    if (!ply.policy.empty()) {
+      V6TrainingData d{};
+      d.version = 6;
+      d.input_format = pblczero::NetworkFormat::INPUT_CLASSICAL_112_PLANE;
+      int transform = 0;
+      InputPlanes planes = EncodePositionForNN(pblczero::NetworkFormat::INPUT_CLASSICAL_112_PLANE, history, 8,
+                                               FillEmptyHistory::FEN_ONLY, &transform);
+      for (int p = 0; p < 104; ++p) d.planes[p] = ReverseBitsInBytes(planes[p].mask);
+      for (auto& x : d.probabilities) x = -1.0f;
+      const MoveList legal = board.GenerateLegalMoves();
+      for (const Move m : legal) d.probabilities[MoveToNNIndex(m, transform)] = 0.0f;
+      float total = 0, best_p = -1;
+      uint16_t best_idx = 0;
+      for (const auto& [u, p] : ply.policy) {
+        const Move m = board.ParseMove(u);
+        const uint16_t idx = MoveToNNIndex(m, transform);
+        if (d.probabilities[idx] < 0) throw Exception("policy move is not legal here: " + u);
+        d.probabilities[idx] += p;
+        total += p;
+        if (p > best_p) best_p = p, best_idx = idx;
+      }
+      if (total <= 0) throw Exception("empty policy");
+      for (auto& x : d.probabilities) if (x > 0) x /= total;
+      const bool black = history.IsBlackToMove();
+      d.side_to_move_or_enpassant = black ? 1 : 0;
+      d.rule50_count = static_cast<uint8_t>(std::min(255, history.Last().GetRule50Ply()));
+      d.invariance_info = 0;
+      if (result == 0) {
+        d.result_q = 0; d.result_d = 1;
+      } else {
+        d.result_q = (result > 0) != black ? 1.0f : -1.0f;   // from the side to move's view
+        d.result_d = 0;
+      }
+      d.plies_left = static_cast<float>(n - i);
+      d.played_idx = MoveToNNIndex(played, transform);
+      d.best_idx = best_idx;
+      d.visits = 10000;
+      writer.WriteChunk(d);
+      ++*written;
+    }
+    history.Append(played);
+  }
+  writer.Finalize();
+}
+
+}  // namespace
+
+void KramnikConvert() {
+  if (!kKramnik) throw Exception("kramnik-convert needs an lc0 built with -DLC0_KRAMNIK");
+  const char* in = std::getenv("KRAMNIK_IN");
+  const char* out = std::getenv("KRAMNIK_OUT");
+  if (!in || !out) throw Exception("set KRAMNIK_IN (games) and KRAMNIK_OUT (directory)");
+  std::ifstream f(in);
+  if (!f) throw Exception(std::string("cannot read ") + in);
+  std::string line, tag;
+  std::vector<Ply> plies;
+  int result = 0;
+  long games = 0, written = 0;
+  while (std::getline(f, line)) {
+    std::istringstream s(line);
+    s >> tag;
+    if (tag == "G") {
+      s >> result;
+      plies.clear();
+    } else if (tag == "M") {
+      Ply p;
+      int k = 0;
+      s >> p.played >> k;
+      for (int j = 0; j < k; ++j) {
+        std::string u;
+        float pr;
+        s >> u >> pr;
+        p.policy.emplace_back(u, pr);
+      }
+      plies.push_back(std::move(p));
+    } else if (tag == "E") {
+      WriteGame(std::string(out) + "/game_" + std::to_string(games) + ".gz", result, plies, &written);
+      ++games;
+    }
+  }
+  std::cout << "kramnik-convert: " << games << " games, " << written << " positions -> " << out << std::endl;
+}
+
+}  // namespace lczero
